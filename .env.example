NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Non-secret status marker for the custom SMTP provider configured in Supabase Auth.
SUPABASE_AUTH_SMTP_PROVIDER=

# Optional Brevo notification sent when a player reports a broken game.
BREVO_API_KEY=
GAME_REPORT_NOTIFICATION_EMAIL=
GAME_REPORT_FROM_EMAIL=
GAME_REPORT_FROM_NAME=Bol Oyun

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=boloyun-assets
R2_PUBLIC_BASE_URL=https://cdn.boloyun.com

AI_PROVIDER=
AI_API_KEY=
AI_SETTINGS_ENCRYPTION_KEY=

# Optional external cron bearer secret for POST /api/admin/ai/automation.
AI_TRANSLATION_CRON_SECRET=

# Runtime role is set by Docker Compose. The public web process must stay "web".
BOL_OYUN_PROCESS_ROLE=web
BACKGROUND_WORKER_ENABLED=false
BACKGROUND_WORKER_ACTIVE_INTERVAL_MS=2000
BACKGROUND_WORKER_IDLE_INTERVAL_MS=15000
BACKGROUND_WORKER_CRAWLER_BATCH_SIZE=2
BACKGROUND_WORKER_AI_LIMIT=5
BACKGROUND_WORKER_IDLE_BACKOFF_INTERVAL_MS=60000
BACKGROUND_WORKER_MAX_IDLE_INTERVAL_MS=300000
BACKGROUND_WORKER_WAKE_URL=http://worker:3002/api/internal/worker/wake

# Legacy AI worker tuning names remain supported as fallbacks.
AI_AUTOMATION_WORKER_ENABLED=false
AI_AUTOMATION_WORKER_INTERVAL_MS=30000
AI_AUTOMATION_WORKER_IDLE_INTERVAL_MS=300000
AI_AUTOMATION_WORKER_LIMIT=5

# Required by internal Docker health/readiness probes. Generate at least 32 random bytes.
INTERNAL_HEALTH_CHECK_TOKEN=

SITE_URL=https://boloyun.com

# Filled by the production image build. Used by Next.js version-skew protection.
DEPLOYMENT_VERSION=

# Abuse subjects are HMAC hashed before storage. Generate at least 32 random bytes.
ABUSE_HASH_SECRET=

# Cloudflare Turnstile is shown only after suspicious form activity.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=boloyun.com

# Database calls above this duration are logged without SQL values or secrets.
SLOW_QUERY_MS=750
