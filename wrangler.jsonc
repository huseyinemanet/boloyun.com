{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boloyun",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "boloyun.com/*", "zone_name": "boloyun.com" },
    { "pattern": "www.boloyun.com/*", "zone_name": "boloyun.com" }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "SITE_ASSETS",
      "bucket_name": "boloyun-assets"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "EMAIL_SERVICE_PROVIDER": "brevo",
    "EMAIL_FROM_ADDRESS": "noreply@boloyun.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
