#!/usr/bin/env bash
set -Eeuo pipefail

readonly project_dir="/opt/boloyun"
readonly compose_file="$project_dir/compose.yml"
readonly runtime_env="$project_dir/.env.production"
readonly state_file="$project_dir/.deploy.env"
readonly deploy_user="boloyun-deploy"
readonly container_name="boloyun-app"
readonly worker_container_name="boloyun-worker"

revision="${1:-}"
if [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Invalid deployment revision." >&2
  exit 2
fi

archive="/home/$deploy_user/boloyun-$revision.tar.gz"
candidate_compose="/home/$deploy_user/boloyun-compose-$revision.yml"
candidate_deploy="/home/$deploy_user/boloyun-deploy-$revision"
if [[ ! -f "$archive" || ! -f "$candidate_compose" || ! -f "$candidate_deploy" ]]; then
  echo "Deployment image or runtime configuration is missing." >&2
  exit 3
fi
if [[ ! -f "$compose_file" || ! -f "$runtime_env" ]]; then
  echo "Production Compose or environment file is missing." >&2
  exit 4
fi
install -d -o 1001 -g 1001 -m 750 "$project_dir/cache"

read_state() {
  local key="$1"
  [[ -f "$state_file" ]] || return 0
  sed -n "s/^${key}=//p" "$state_file" | tail -n 1
}

write_state() {
  local current="$1"
  local previous="${2:-}"
  local temporary
  temporary="$(mktemp "$project_dir/.deploy.env.XXXXXX")"
  printf 'IMAGE_TAG=%s\n' "$current" > "$temporary"
  if [[ -n "$previous" ]]; then printf 'PREVIOUS_IMAGE_TAG=%s\n' "$previous" >> "$temporary"; fi
  chmod 600 "$temporary"
  mv "$temporary" "$state_file"
}

health_token="$(sed -n 's/^INTERNAL_HEALTH_CHECK_TOKEN=//p' "$runtime_env" | tail -n 1)"
if [[ -z "$health_token" ]]; then
  echo "INTERNAL_HEALTH_CHECK_TOKEN is missing from production environment." >&2
  exit 6
fi

bash -n "$candidate_deploy"

container_status() {
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$1" 2>/dev/null || true
}

wait_until_app_healthy() {
  local app_status
  for _ in $(seq 1 18); do
    app_status="$(container_status "$container_name")"
    if [[ "$app_status" == "healthy" ]]; then
      if curl --fail --silent --show-error --max-time 10 -H "Authorization: Bearer $health_token" http://127.0.0.1:3001/api/ready >/dev/null; then return 0; fi
    fi
    if [[ "$app_status" == "unhealthy" || "$app_status" == "exited" || "$app_status" == "dead" ]]; then return 1; fi
    sleep 5
  done
  return 1
}

wait_until_legacy_app_healthy() {
  local app_status
  for _ in $(seq 1 18); do
    app_status="$(container_status "$container_name")"
    if [[ "$app_status" == "healthy" ]]; then
      if curl --fail --silent --show-error --max-time 10 http://127.0.0.1:3001/robots.txt >/dev/null; then return 0; fi
    fi
    if [[ "$app_status" == "unhealthy" || "$app_status" == "exited" || "$app_status" == "dead" ]]; then return 1; fi
    sleep 5
  done
  return 1
}

wait_until_healthy() {
  local app_status worker_status
  for _ in $(seq 1 18); do
    app_status="$(container_status "$container_name")"
    worker_status="$(container_status "$worker_container_name")"
    if [[ "$app_status" == "healthy" && "$worker_status" == "healthy" ]]; then
      if curl --fail --silent --show-error --max-time 10 -H "Authorization: Bearer $health_token" http://127.0.0.1:3001/api/ready >/dev/null; then return 0; fi
    fi
    if [[ "$app_status" == "unhealthy" || "$app_status" == "exited" || "$app_status" == "dead" ]]; then return 1; fi
    if [[ "$worker_status" == "unhealthy" || "$worker_status" == "exited" || "$worker_status" == "dead" ]]; then return 1; fi
    sleep 5
  done
  return 1
}

current_revision="$(read_state IMAGE_TAG)"
older_revision="$(read_state PREVIOUS_IMAGE_TAG)"
if [[ -n "$current_revision" && ! "$current_revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Current deployment state is invalid." >&2
  exit 5
fi

echo "Loading image for $revision"
gzip -dc "$archive" | docker load
docker image inspect "boloyun:$revision" >/dev/null

candidate_state="$(mktemp "$project_dir/.deploy.candidate.XXXXXX")"
printf 'IMAGE_TAG=%s\n' "$revision" > "$candidate_state"
chmod 600 "$candidate_state"
docker compose --project-directory "$project_dir" --env-file "$candidate_state" -f "$candidate_compose" config >/dev/null

echo "Starting candidate $revision"
if docker compose --project-directory "$project_dir" --env-file "$candidate_state" -f "$candidate_compose" up -d --no-deps app worker \
  && wait_until_healthy; then
  install -o root -g root -m 640 "$candidate_compose" "$compose_file"
  install -o root -g root -m 755 "$candidate_deploy" /usr/local/sbin/boloyun-deploy
  write_state "$revision" "$current_revision"
  rm -f "$candidate_state" "$archive" "$candidate_compose" "$candidate_deploy"
  if [[ -n "$older_revision" && "$older_revision" != "$current_revision" && "$older_revision" != "$revision" ]]; then
    docker image rm "boloyun:$older_revision" >/dev/null 2>&1 || true
  fi
  echo "Deployment $revision is healthy."
  exit 0
fi

echo "Candidate failed health checks; rolling back." >&2
if [[ -n "$current_revision" ]]; then
  rollback_state="$(mktemp "$project_dir/.deploy.rollback.XXXXXX")"
  printf 'IMAGE_TAG=%s\n' "$current_revision" > "$rollback_state"
  chmod 600 "$rollback_state"
  if docker compose --project-directory "$project_dir" --env-file "$rollback_state" -f "$compose_file" config --services | grep -qx worker; then
    docker compose --project-directory "$project_dir" --env-file "$rollback_state" -f "$compose_file" up -d --no-deps app worker
    wait_until_healthy || echo "Rollback services did not become healthy." >&2
  else
    docker rm -f "$worker_container_name" >/dev/null 2>&1 || true
    docker compose --project-directory "$project_dir" --env-file "$rollback_state" -f "$compose_file" up -d --no-deps app
    wait_until_legacy_app_healthy || echo "Rollback container did not become healthy." >&2
  fi
  rm -f "$rollback_state"
else
  docker compose --project-directory "$project_dir" --env-file "$candidate_state" -f "$candidate_compose" down || true
fi
rm -f "$candidate_state" "$archive" "$candidate_compose" "$candidate_deploy"
docker image rm "boloyun:$revision" >/dev/null 2>&1 || true
exit 1
