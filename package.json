{
  "name": "boloyun-com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "import:discover": "tsx src/import/cli/import-discover.ts",
    "import:scrape": "tsx src/import/cli/import-scrape.ts",
    "import:generate-content": "tsx src/import/cli/import-generate-content.ts",
    "import:approve": "tsx src/import/cli/import-approve.ts",
    "import:retry-failed": "tsx src/import/cli/import-retry-failed.ts",
    "covers:migrate": "tsx src/import/cli/covers-migrate.ts",
    "covers:retry": "tsx src/import/cli/covers-retry.ts",
    "covers:audit": "tsx src/import/cli/covers-audit.ts",
    "covers:rollback": "tsx src/import/cli/covers-rollback.ts",
    "seo:seed-static-pages": "tsx src/import/cli/seed-static-pages.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@opennextjs/cloudflare": "1.20.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-table": "^8.21.3",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "nucleo-ui-fill-duo-18": "^1.5.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.110.0"
